extends "res://tools/playtest_v2.gd"
const BalanceModel=preload("res://day1/balance_model.gd")
func run_tests() -> void:
 create_timer(85).timeout.connect(func():printerr("TUNING timeout");quit(2))
 for rate in [30,60,120]:
  var balance=BalanceModel.new()
  for step in range(rate*12):
   balance.advance(1.0/rate,clampf(-balance.position*4-balance.velocity*2.5,-1,1))
   if balance.status!=0:break
  verify(balance.status==1 and balance.safe_half<=.20,"Faster balance cannot be steered at "+str(rate)+" FPS")
 var unattended=BalanceModel.new();unattended.advance(12,0)
 verify(unattended.status==-1,"Leaving the faster balance unattended still wins")
 var shrinking=BalanceModel.new();shrinking.advance(3,0)
 verify(shrinking.safe_half<.30,"Safe bar does not shrink faster")
 game=load("res://scenes/main.tscn").instantiate();game.get_node("QuestSystem").save_enabled=false;root.add_child(game);current_scene=game
 game.start_game();await ticks(8)
 day=game.get_node("DayOne");second=game.get_node("DayTwo");chapter=game.get_node("ActTwo");third=game.get_node("ActThree");dismiss()
 game._seed_demo_day(2)
 for key_ in ["d2_note","daily_note_ack_2","d2_washed","yarn_freed","yarn_home","d2_dog_fed","d2_cat_fed"]:second.set_flag(key_,true)
 second.set_value("dish_flow_version",2);second.set_value("dish_stage",1);second.restore_world()
 var rinse=second.rinse
 verify(rinse.begin(),"Rinse cannot begin with the ready dirty plate")
 if not rinse.running:quit(1);return
 rinse.set_physics_process(false);rinse.offset=Vector2(.15,.15)
 var areas=[]
 rinse.progress.assign([0.0,0.0,0.0]);rinse.update_plate()
 for patch in second.world.stains.get_children():areas.append(patch_area(patch))
 for amount in [.25,.5,.75,.99]:
  rinse.progress.assign([amount,amount,amount]);rinse.update_plate()
  for i in range(3):
   var patch=second.world.stains.get_child(i)
   verify(patch.visible and absf(patch_area(patch)/areas[i]-(1.0-amount))<.001,"Visible residue area does not match the remaining percentage at "+str(amount))
   for mesh in patch.get_children():
    var bounds: AABB=mesh.global_transform*mesh.get_aabb()
    verify(bounds.position.y>second.world.items.dog_bowl.global_position.y+.071,"Residue sinks under the bowl surface before being clean")
 rinse.progress.assign([.5,.5,.5]);rinse.update_plate()
 verify(is_equal_approx(rinse.ui.progress.value,50) and "剩余残渣 50%" in rinse.ui.title.text,"50-percent rinse UI disagrees with visible residue")
 rinse.offset=Vector2.ZERO;rinse.update_plate();await ticks(3)
 verify(rinse.hint_panel.size.y<250,"Rinse instructions cover the bowl instead of staying above it")
 await capture("tuning_rinse50")
 rinse.toggle_pause();rinse.stop();verify(rinse.begin(),"Half-clean plate cannot be resumed");rinse.set_physics_process(false)
 verify(rinse.progress==[.5,.5,.5],"Resuming changed residue percentages")
 rinse.progress.assign([1.0,1.0,1.0]);rinse.advance(0)
 verify(second.val("dish_stage")==8 and not rinse.running,"Fully removed residue does not finish washing")
 await prepare_day(6)
 for key_ in ["a6_note","daily_note_ack_6","a6_feed","a6_permission"]:third.set_flag(key_,false)
 third.panel.close();third.interact_item("dog")
 verify(third.panel.mode.is_empty() and not third.flag("a6_feed") and not third.flag("a6_permission"),"Unread day-six note allows hungry dialogue or progression")
 third.set_value("d2_holding",5);third.set_flag("dog_portion")
 third.interact_item("dog")
 verify(third.val("d2_holding")==5 and third.flag("dog_portion") and not third.flag("a6_feed"),"Unread note permits feeding through the dog dialogue")
 third.interact_item("note");await key(KEY_ESCAPE);third.interact_item("dog")
 verify(not day.Notes.read(day) and third.panel.mode.is_empty(),"Opening then cancelling the paper unlocks day-six dog dialogue")
 third.interact_item("note");await key(KEY_E)
 verify(day.Notes.read(day),"Confirming day-six paper does not unlock the task")
 third.interact_item("dog");verify(third.flag("a6_feed"),"Reading paper no longer allows feeding the dog")
 third.interact_item("dog");verify(third.flag("a6_permission") and not third.panel.mode.is_empty(),"Reading paper no longer allows the permission dialogue")
 dismiss();await prepare_day(3)
 chapter.set_value("books_v2_version",2);chapter.set_flag("book0");chapter.set_flag("book1");chapter.set_flag("a3_books",false);chapter.migrate_books()
 verify(chapter.flag("book0") and chapter.flag("book1") and not chapter.flag("a3_books") and chapter.val("books_v2_version")==3,"Seven-book migration loses partially collected books")
 chapter.set_flag("a3_books");chapter.set_value("books_v2_version",2);chapter.migrate_books()
 var saved_order=[]
 for i in range(Rules.BOOK_COUNT):saved_order.append(chapter.val("book_slot_%d"%i))
 verify(saved_order==Rules.BOOK_GOAL and chapter.flag("a3_books"),"Seven-book migration makes completed players repeat sorting")
 chapter.set_flag("book2");chapter.restore();chapter.open_panel("books");await ticks(3)
 verify(chapter.puzzle.book_order.size()==7 and chapter.world.extra_shelf_books.size()==4,"Seven spines do not match seven physical books")
 await capture("tuning_seven_spines");await key(KEY_ESCAPE)
 var fourth=game.get_node("ActFour")
 fourth.begin_day(8);dismiss();fourth.panel.close()
 day.manager.set_flag(&"daily_note_ack_8",true);fourth.mark("a8_food");fourth.interact_item("valve");await ticks(3)
 verify(fourth.world.items.valve.has_meta("normal_temperature_scale") and fourth.world.items.valve.find_children("OpaqueCalcium*","MeshInstance3D",true,false).is_empty(),"Physical temperature dial still has limescale")
 verify(fourth.world.items.limescale.find_children("MineralStickerEdge*","MeshInstance3D",true,false).is_empty(),"Instruction plaque still has limescale")
 verify(not fourth.panel.description.text.contains("水垢") and not fourth.panel.feedback.text.contains("磨痕"),"Shower instructions still refer to hidden numbers or the old answer clue")
 await capture("tuning_shower");fourth.panel.close()
 fourth.begin_day(10);fourth.panel.close();day.manager.set_flag(&"daily_note_ack_10",true)
 fourth.set_value("mouse_stage",0);fourth.restore()
 var mouse=fourth.world.items.mouse;var before: Vector3=mouse.global_position
 fourth.chase_mouse();fourth.advance_mouse(.1)
 verify(mouse.global_position.distance_to(before)>.39,"Mouse floor speed was not increased to 4 metres per second")
 fourth.chase_path=[Vector3(4,.02,2.05),Vector3(4,1.52,-1.02)];fourth.chase_point=1;mouse.global_position=fourth.chase_path[0]
 fourth.advance_mouse(.1)
 verify(absf(mouse.global_position.z-(2.05-.17))<.001,"Mouse stair speed was not increased")
 fourth.chase_path.clear();fourth.panel.close()
 await prepare_day(7);third.set_flag("a7_power");third.set_flag("a7_computer_power");third.set_flag("a7_login");third.restore();third.interact_item("computer")
 var apps=third.computer.apps;apps.open_app("recycle");await ticks(3)
 verify(apps.file_tree!=null and apps.file_tree.columns==4,"Recycle bin has no Windows-style file columns")
 var item=apps.file_tree.get_root().get_children()[0]
 var point=apps.file_tree.global_position+apps.file_tree.get_item_area_rect(item,0).get_center()
 for click_ in range(2):
  var event=InputEventMouseButton.new();event.button_index=MOUSE_BUTTON_LEFT;event.pressed=true;event.double_click=click_==1;event.position=point;root.push_input(event,true);await process_frame
  event.pressed=false;root.push_input(event,true);await process_frame
 verify(apps.page=="photo" and third.flag("a7_read_photo"),"Double-clicking a real recycle-bin row cannot open the photograph")
 await key(KEY_ESCAPE);await click_named(apps.body,"还原选定项目")
 verify(third.flag("lab_photo_restored") and apps.app=="photos" and apps.page=="lab_photo","Restoring the photograph does not move it into Pictures")
 await key(KEY_ESCAPE);await key(KEY_ESCAPE);await key(KEY_ESCAPE)
 verify(day.active_play(),"Restored-photo windows do not return control")
 third.interact_item("computer");apps.open_app("chat");apps.show_page("conversation");await ticks(3)
 verify(root.get_visible_rect().encloses(apps.panel.get_global_rect()),"Chat window overflows the screen")
 await capture("tuning_chat")
 apps.open_app("browser");apps.show_browser("site");await ticks(3);await capture("tuning_website")
 await click_named(apps.panel,"—");verify(not apps.panel.visible and apps.app=="browser","Minimize discards the browser")
 await click_named(third.computer.desktop,"BrowserIcon");verify(apps.panel.visible and apps.browser_page=="site","Desktop icon cannot restore a minimized browser")
 await click_named(apps.panel,"□");await ticks(2)
 verify(apps.maximized and root.get_visible_rect().encloses(apps.panel.get_global_rect()),"Maximized app escapes the screen")
 await click_named(apps.panel,"□")
 apps.open_app("recycle");await ticks(3);await capture("tuning_recycle")
 await key(KEY_ESCAPE);await key(KEY_ESCAPE)
 verify(not day.manager.autosave,"Tuning validation can overwrite player saves")
 print("GAME_TUNING ",JSON.stringify({"checks":checks,"failures":failures}))
 game.stop_audio();game.queue_free();await ticks(3);quit(0 if failures.is_empty() else 1)
func patch_area(patch: Node3D) -> float:
 var bounds: AABB=patch.get_child(0).global_transform*patch.get_child(0).get_aabb()
 for mesh in patch.get_children():bounds=bounds.merge(mesh.global_transform*mesh.get_aabb())
 return bounds.size.x*bounds.size.z
