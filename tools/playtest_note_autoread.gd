extends "res://tools/playtest_pre11_story.gd"

func run() -> void:
	create_timer(90).timeout.connect(func():printerr("AUTOREAD_TIMEOUT");quit(2))
	game=load("res://scenes/main.tscn").instantiate();game.get_node("QuestSystem").save_enabled=false;root.add_child(game);current_scene=game;game.start_game();await ticks(12)
	day=game.get_node("DayOne");branch=game.get_node("StoryBranches");fourth=game.get_node("ActFour");ending=game.get_node("Ending");dismiss()
	for number in range(1,12):
		dismiss();game._seed_demo_day(number)
		if number==11:day.manager.apply_story_patch({}, {"br_day11_intro_state":2},false)
		await ticks(4);dismiss()
		verify(not day.flag("daily_note_ack_%d"%number),"Current day's note starts unread: %d"%number)
		if number==5:
			day.manager.apply_story_patch({"letter_dropped":true},{},false);game.get_node("ActTwo").restore();game.get_node("ActTwo").interact_item("letter")
		else:day.show_dialog("note")
		verify(not day.flag("daily_note_ack_%d"%number),"Preloading isn't reading: %d"%number)
		await ticks(5)
		await process_frame;await process_frame;await process_frame
		verify(day.flag("daily_note_ack_%d"%number),"Successful presentation auto records day%d"%number)
		verify(day.Notes.read(day),"Daily gate opens after actual presentation: %d"%number)
		verify(not day.reader.confirm.visible,"No mandatory second-confirm button")
		verify(not day.flag("a%d_complete"%number) and day.value("current_day",1)==number,"Reading does not complete or change day")
		if number==5:verify(day.flag("a5_letter") and not day.flag("a5_medicine"),"Letter does not give medicine")
		await key(KEY_E);await key(KEY_ENTER);await key(KEY_SPACE)
		verify(not day.reader.mode.is_empty(),"Opening/confirm keys do not close reading page")
		await capture("autoread_day%d"%number)
		await key(KEY_ESCAPE)
		verify(day.reader.mode.is_empty() and game.player.active and not game.cinematic_active,"One Esc restores control for day%d"%number)
		var before=day.manager.make_save_data();day.show_dialog("note") if number!=5 else day.reader.open_sheet("letter");await ticks(5)
		await process_frame;await process_frame;await process_frame;await key(KEY_ESCAPE)
		verify(before==day.manager.make_save_data(),"Repeat read has no extra progress: %d"%number)
	dismiss();game._seed_demo_day(10);await ticks(3);dismiss()
	day.reader.open_daily(10);day.reader.cancel();await ticks(5)
	verify(not day.flag("daily_note_ack_10"),"Closing before first presentation does not fabricate reading")
	day.reader.open_sheet("evidence_missing");await ticks(5)
	verify(not branch.flag("br_doc_missing_read"),"Missing content never becomes evidence")
	await key(KEY_ESCAPE)
	fourth.open_panel("story");var prior_focus=root.gui_get_focus_owner()
	day.reader.open_sheet("escape");await ticks(5)
	await process_frame;await process_frame;await process_frame;await key(KEY_ESCAPE)
	verify(fourth.panel.shell.visible and not game.player.active and game.cinematic_active,"Nested reader returns to its parent without unlocking movement")
	verify(branch.flag("a10_note") and not branch.flag("a10_asked"),"Escape paper does not auto-complete dog conversation")
	verify(prior_focus==null or root.gui_get_focus_owner()==prior_focus,"Nested reader restores valid focus")
	dismiss();await ticks(2)
	print("AUTOREAD_TEST ",JSON.stringify({"checks":checks,"failures":failures}))
	branch.set_physics_process(false);game.stop_audio();game.queue_free();await process_frame;await process_frame
	quit(0 if failures.is_empty() else 1)
