extends RefCounted
const KEYS=["photo","site","chat","news"]
const SITE="XX生物实验室\n关于我们\n\n我们致力于人类意识的形成机制、信息保存与转移研究，探索生命科学与认知技术的交叉应用。\n\n研究方向\n意识活动的观测与建模、记忆信息的保存，以及跨载体信息转移的基础研究。\n\n科研环境\n实验室设有独立的认知研究区、样本分析区和长期观测室。研究团队通过持续记录与跨学科合作，探索意识与生命科学的边界。"
const CHAT="一个月前\n\n09:12  X主任：有关实验室负面消息，你联系人去处理一下。\n09:13  X主任：xxxxxxxxxxxxx\n09:14  我：收到。"
const NEWS=[
 {"title":"XX生物实验室被质疑开展人体研究","body":"一个月前 · XX新闻\n\n多位知情人士向记者反映，XX生物实验室的部分研究可能涉及未经充分说明的人体实验。实验室公开资料将其研究方向表述为意识机制与信息转移，但未就相关质疑作出详细回应。\n记者已经发出采访请求。截至发稿，尚未收到明确答复。"},
 {"title":"XX实验室某分研究所周边发生多起失踪事件","body":"一个月前 · XX新闻\n\n近日，有家属反映，亲属在XX生物实验室一处分研究所附近失去联系。居民表示，研究所长期限制外来人员进入，夜间仍有车辆出入。\n失踪事件与研究所之间是否存在关联，尚有待调查。家属希望有关方面公布更多信息。"},
