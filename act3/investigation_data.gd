static func news_summary() -> String:
 var result="XX新闻 · 一个月前\n\n"
 for article in NEWS:result+=article.title+"\n\n"
 return result+"聊天记录里的X主任发来这条新闻链接，要求联系人处理实验室的负面消息。\n\n这些报道究竟有多少是真的？"
