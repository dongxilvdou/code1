[gd_resource type="Resource" script_class="CalicoQuest" format=3]

[ext_resource type="Script" path="res://quest_system/types/quest_definition.gd" id="quest"]
[ext_resource type="Script" path="res://quest_system/types/quest_objective.gd" id="goal"]
[ext_resource type="Resource" path="res://day1/quests/lights.tres" id="pre"]

[sub_resource type="Resource" id="collect_paper"]
script = ExtResource("goal")
id = &"collect_paper"
text = "收集各房间的纸片"
kind = 3
target_id = &"collect_paper"
target_count = 17

[resource]
script = ExtResource("quest")
id = &"day1_papers"
title = "02 · 散落的纸片"
description = "每个房间一张纸片，共 17 张，包括地下室、阅读角、露台与过厅。"
priority = 98
prerequisite_quests = Array[ExtResource("quest")]([ExtResource("pre")])
objectives = Array[ExtResource("goal")]([SubResource("collect_paper")])
result_text = "去厨房解开给予器，给自己和大狗嚼喂食"
