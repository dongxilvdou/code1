target_id = &"yarn_home"

[resource]
script = ExtResource("quest")
id = &"day1_yarn"
title = "02 · 沙发底下的秘密"
description = "去一楼东南角工作书房找尺子；R 切换竖叼，从沙发前侧够出毛线球，再叼回猫窝。"
priority = 88
prerequisite_quests = Array[ExtResource("quest")]([ExtResource("pre")])
objectives = Array[ExtResource("goal")]([SubResource("ruler_found"), SubResource("yarn_freed"), SubResource("yarn_home")])
result_text = "毛线球上发现了不属于自己的猫毛。接下来洗净大狗嚼的盘子。"
