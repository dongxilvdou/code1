[resource]
script = ExtResource("quest")
id = &"q01"
title = "初来乍到"
description = "先熟悉客厅，再用一声喵叫向新家问好。"
priority = 99
objectives = Array[ExtResource("goal")]([SubResource("living"), SubResource("hello")])
