[gd_resource type="Resource" script_class="CalicoQuest" load_steps=7 format=3]

[ext_resource type="Script" path="res://quest_system/types/quest_definition.gd" id="quest"]
[ext_resource type="Script" path="res://quest_system/types/quest_objective.gd" id="goal"]
[ext_resource type="Script" path="res://quest_system/types/quest_result.gd" id="result"]

[sub_resource type="Resource" id="living"]
script = ExtResource("goal")
id = &"living"
text = "到达一层客厅"
kind = 0
room_id = "floor_1/living"
target_count = 1

[sub_resource type="Resource" id="hello"]
script = ExtResource("goal")
id = &"hello"
text = "按 Q 喵叫一声"
kind = 1
room_id = "any"
target_count = 1

[sub_resource type="Resource" id="points"]
script = ExtResource("result")
kind = 1
key = &"exploration_points"
amount = 5

[resource]
script = ExtResource("quest")
id = &"q01"
title = "初来乍到"
description = "先熟悉客厅，再用一声喵叫向新家问好。"
main_quest = true
priority = 99
auto_accept = true
objectives = Array[ExtResource("goal")]([SubResource("living"), SubResource("hello")])
result_text = "探索积分 +5，开启一楼巡游"
success_results = Array[ExtResource("result")]([SubResource("points")])
