[sub_resource type="Resource" id="living"]
script = ExtResource("goal")
id = &"living"
text = "到达一层客厅"
room_id = "floor_1/living"

[sub_resource type="Resource" id="hello"]
script = ExtResource("goal")
id = &"hello"
text = "按 Q 喵叫一声"
kind = 1

[sub_resource type="Resource" id="points"]
script = ExtResource("result")
