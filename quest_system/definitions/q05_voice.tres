[gd_resource type="Resource" script_class="CalicoQuest" load_steps=11 format=3]

[ext_resource type="Script" path="res://quest_system/types/quest_definition.gd" id="quest"]
[ext_resource type="Script" path="res://quest_system/types/quest_objective.gd" id="goal"]
[ext_resource type="Script" path="res://quest_system/types/quest_result.gd" id="result"]
[ext_resource type="Resource" path="res://quest_system/definitions/q02_downstairs.tres" id="pre0"]
[ext_resource type="Resource" path="res://quest_system/definitions/q03_upstairs.tres" id="pre1"]
[ext_resource type="Script" path="res://quest_system/types/quest_condition.gd" id="condition"]

[sub_resource type="Resource" id="meows"]
script = ExtResource("goal")
id = &"meows"
text = "接取后按 Q 喵叫三声"
kind = 1
room_id = "any"
target_count = 3

[sub_resource type="Resource" id="points"]
script = ExtResource("result")
kind = 1
key = &"exploration_points"
amount = 5

[sub_resource type="Resource" id="flag"]
script = ExtResource("result")
kind = 0
key = &"home_greeted"
flag_value = true

[sub_resource type="Resource" id="extra"]
script = ExtResource("condition")
kind = 0
key = &"downstairs_done"
expected_flag = true

[resource]
script = ExtResource("quest")
id = &"q05"
title = "回应这座家"
description = "可选的小目标：再喵叫三声，让家里热闹起来。"
main_quest = false
priority = 95
auto_accept = false
prerequisite_quests = Array[ExtResource("quest")]([ExtResource("pre0"), ExtResource("pre1")])
prerequisite_mode = 1
extra_conditions = Array[ExtResource("condition")]([SubResource("extra")])
objectives = Array[ExtResource("goal")]([SubResource("meows")])
result_text = "探索积分 +5，留下问候记录"
success_results = Array[ExtResource("result")]([SubResource("points"), SubResource("flag")])
