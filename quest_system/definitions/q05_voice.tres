[gd_resource type="Resource" script_class="CalicoQuest" format=3 uid="uid://bpdmnmxo6qb86"]

[ext_resource type="Script" uid="uid://ckic3pnixb8df" path="res://quest_system/types/quest_condition.gd" id="condition"]
[ext_resource type="Script" uid="uid://wysbtefcww71" path="res://quest_system/types/quest_objective.gd" id="goal"]
[ext_resource type="Resource" uid="uid://b67wkncys5bm6" path="res://quest_system/definitions/q02_downstairs.tres" id="pre0"]
[ext_resource type="Resource" uid="uid://dpald3wwaeahi" path="res://quest_system/definitions/q03_upstairs.tres" id="pre1"]
[ext_resource type="Script" uid="uid://hp5cinuqpqdn" path="res://quest_system/types/quest_definition.gd" id="quest"]
[ext_resource type="Script" uid="uid://c3x0yng5f7vwk" path="res://quest_system/types/quest_result.gd" id="result"]

[sub_resource type="Resource" id="extra"]
script = ExtResource("condition")
key = &"downstairs_done"

[sub_resource type="Resource" id="meows"]
script = ExtResource("goal")
id = &"meows"
text = "接取后按 Q 喵叫三声"
kind = 1
target_count = 3

[sub_resource type="Resource" id="points"]
script = ExtResource("result")
kind = 1
key = &"exploration_points"
amount = 5

[sub_resource type="Resource" id="flag"]
script = ExtResource("result")
key = &"home_greeted"

[resource]
script = ExtResource("quest")
id = &"q05"
title = "回应这座家"
description = "可选的小目标：再喵叫三声，让家里热闹起来。"
main_quest = false
priority = 95
auto_accept = false
prerequisite_mode = 1
prerequisite_quests = Array[ExtResource("quest")]([ExtResource("pre0"), ExtResource("pre1")])
extra_conditions = Array[ExtResource("condition")]([SubResource("extra")])
objectives = Array[ExtResource("goal")]([SubResource("meows")])
result_text = "探索积分 +5，留下问候记录"
success_results = Array[ExtResource("result")]([SubResource("points"), SubResource("flag")])
