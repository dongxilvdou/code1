[gd_resource type="Resource" script_class="CalicoQuest" load_steps=9 format=3]

[ext_resource type="Script" path="res://quest_system/types/quest_definition.gd" id="quest"]
[ext_resource type="Script" path="res://quest_system/types/quest_objective.gd" id="goal"]
[ext_resource type="Script" path="res://quest_system/types/quest_result.gd" id="result"]
[ext_resource type="Resource" path="res://quest_system/definitions/q02_downstairs.tres" id="pre0"]

[sub_resource type="Resource" id="study"]
script = ExtResource("goal")
id = &"study"
text = "到达二层书房"
kind = 0
room_id = "floor_2/study"
target_count = 1

[sub_resource type="Resource" id="terrace"]
script = ExtResource("goal")
id = &"terrace"
text = "到达二层露台"
kind = 0
room_id = "floor_2/terrace"
target_count = 1

[sub_resource type="Resource" id="points"]
script = ExtResource("result")
kind = 1
key = &"exploration_points"
amount = 15

[sub_resource type="Resource" id="flag"]
script = ExtResource("result")
kind = 0
key = &"upstairs_done"
flag_value = true

[resource]
script = ExtResource("quest")
id = &"q03"
title = "楼上的风景"
description = "走上楼梯，寻找书房和露台。"
main_quest = true
priority = 97
auto_accept = true
prerequisite_quests = Array[ExtResource("quest")]([ExtResource("pre0")])
objectives = Array[ExtResource("goal")]([SubResource("study"), SubResource("terrace")])
result_text = "探索积分 +15，开启花园探索"
success_results = Array[ExtResource("result")]([SubResource("points"), SubResource("flag")])
