[gd_resource type="Resource" script_class="CalicoQuest" format=3 uid="uid://b67wkncys5bm6"]

[ext_resource type="Script" uid="uid://ckic3pnixb8df" path="res://quest_system/types/quest_condition.gd" id="1_xtevc"]
[ext_resource type="Script" uid="uid://wysbtefcww71" path="res://quest_system/types/quest_objective.gd" id="goal"]
[ext_resource type="Resource" uid="uid://xxqo6v1ww05o" path="res://quest_system/definitions/q01_arrival.tres" id="pre0"]
[ext_resource type="Script" uid="uid://hp5cinuqpqdn" path="res://quest_system/types/quest_definition.gd" id="quest"]
[ext_resource type="Script" uid="uid://c3x0yng5f7vwk" path="res://quest_system/types/quest_result.gd" id="result"]

[sub_resource type="Resource" id="dining"]
script = ExtResource("goal")
id = &"dining"
text = "到达一层餐厅"
room_id = "floor_1/dining"

[sub_resource type="Resource" id="kitchen"]
script = ExtResource("goal")
id = &"kitchen"
text = "到达一层厨房"
room_id = "floor_1/kitchen"

[sub_resource type="Resource" id="points"]
script = ExtResource("result")
kind = 1
key = &"exploration_points"
amount = 10

[sub_resource type="Resource" id="flag"]
script = ExtResource("result")
key = &"downstairs_done"

[resource]
script = ExtResource("quest")
id = &"q02"
title = "一楼巡游"
description = "去餐厅和厨房看看，熟悉一楼的生活空间。"
priority = 98
prerequisite_quests = Array[ExtResource("quest")]([ExtResource("pre0")])
objectives = Array[ExtResource("goal")]([SubResource("dining"), SubResource("kitchen")])
result_text = "探索积分 +10，开启楼上探索"
success_results = Array[ExtResource("result")]([SubResource("points"), SubResource("flag")])
