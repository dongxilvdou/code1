[sub_resource type="Resource" id="door"]
script = ExtResource("goal")
id = &"door"
text = "用 E 打开任意房门"
kind = 2

[sub_resource type="Resource" id="garden"]
script = ExtResource("goal")
id = &"garden"
text = "到达北侧花园"
room_id = "garden/north"

[sub_resource type="Resource" id="points"]
script = ExtResource("result")
kind = 1
key = &"exploration_points"
amount = 20

[sub_resource type="Resource" id="flag"]
script = ExtResource("result")
key = &"villa_explored"

[resource]
script = ExtResource("quest")
id = &"q04"
title = "去花园走走"
description = "用 E 打开一扇门，去房屋北侧花园散步。"
priority = 96
prerequisite_quests = Array[ExtResource("quest")]([ExtResource("pre0")])
objectives = Array[ExtResource("goal")]([SubResource("door"), SubResource("garden")])
result_text = "探索积分 +20，完成别墅探索"
success_results = Array[ExtResource("result")]([SubResource("points"), SubResource("flag")])
