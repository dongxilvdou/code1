[resource]
script = ExtResource("quest")
id = &"day2_feed"
title = "03 · 两份晚饭"
description = "数给予器上三列爪印解锁，叼猫碗盛猫粮回原位吃；叼狗盘盛狗粮送到大狗嚼身边。"
priority = 97
prerequisite_quests = Array[ExtResource("quest")]([ExtResource("pre")])
objectives = Array[ExtResource("goal")]([SubResource("d2_unlocked"), SubResource("d2_cat_fed"), SubResource("d2_dog_fed")])
result_text = "给予器永久解锁，之后随时补粮"
