[gd_resource type="Resource" script_class="CalicoQuest" format=3 uid="uid://tv0htnfxvm7y"]

[ext_resource type="Script" uid="uid://c3x0yng5f7vwk" path="res://quest_system/types/quest_result.gd" id="2_88kbq"]
[ext_resource type="Script" uid="uid://ckic3pnixb8df" path="res://quest_system/types/quest_condition.gd" id="condition"]
[ext_resource type="Script" uid="uid://wysbtefcww71" path="res://quest_system/types/quest_objective.gd" id="goal"]
[ext_resource type="Script" uid="uid://hp5cinuqpqdn" path="res://quest_system/types/quest_definition.gd" id="quest"]

[sub_resource type="Resource" id="day"]
script = ExtResource("condition")
kind = 1
key = &"current_day"
required_value = 11

[sub_resource type="Resource" id="prior"]
script = ExtResource("condition")
key = &"a11_enter"

[sub_resource type="Resource" id="a11_finished"]
script = ExtResource("goal")
id = &"a11_finished"
text = "完成选择并确认救援结果。"
kind = 3
target_id = &"a11_finished"

[resource]
script = ExtResource("quest")
id = &"a11_finished"
title = "05 · 离开分站"
description = "结局篇 · 完成选择并确认救援结果。"
priority = 114
extra_conditions = Array[ExtResource("condition")]([SubResource("day"), SubResource("prior")])
objectives = Array[ExtResource("goal")]([SubResource("a11_finished")])
result_text = "这一段经历已经结束。"
